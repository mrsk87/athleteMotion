# ==============================================================================
# Athlete Motion Backend — Variáveis de Ambiente (.env.example)
# ==============================================================================

# Ambiente de execução: dev | prod
ATHLETE_ENV=dev

# Endereço de escuta (127.0.0.1 por padrão; modo local isolado)
ATHLETE_HOST=127.0.0.1
ATHLETE_PORT=8000

# Recarregamento automático (apenas dev)
ATHLETE_RELOAD=false

# Modo LAN (exposição à rede local). ATENÇÃO: exige obrigatoriamente API_TOKEN!
LAN_MODE=false

# Token de autenticação Bearer (se vazio em dev local, um token aleatório é gerado em %APPDATA%/AthleteMotion/api_token)
API_TOKEN=

# Origens permitidas pelo CORS (separadas por vírgula, sem trailing slash)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Documentação OpenAPI (/docs, /redoc) — ativo por defeito em dev, desligado em prod
ENABLE_DOCS=true

# Limites de taxa de requisições (Rate Limiting)
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_STRICT_PER_MINUTE=10

# Gestão de concorrência de motores
MAX_ACTIVE_ENGINES=2
WARMUP_ON_START=false
